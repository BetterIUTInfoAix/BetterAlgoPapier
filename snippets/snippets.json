{
	"fonction": {
		"prefix": "fonction",
		"body": [
			"fonction ${1:nom}(${2:variable : marqueur type}) renvoie ${3|entier,entier_naturel,reel,booleen,caractere,string,tableau_de|}",
			"debut",
			"\t$0",
			"fin"
		],
		"description": "Bloc de fonction (marqueur : in, out ou in_out)"
	},
	"procedure": {
		"prefix": "procedure",
		"body": [
			"procedure ${1:nom}(${2:variable : marqueur type})",
			"debut",
			"\t$0",
			"fin"
		],
		"description": "Bloc de procedure (marqueur : in, out ou in_out)"
	},
	"algorithme": {
		"prefix": "algorithme",
		"body": [
			"algorithme ${1:nom}",
			"debut",
			"\t$0",
			"fin"
		],
		"description": "Insertion d'un bloc d'algorithme"
	},
	"afficher": {
		"prefix": "afficher",
		"body": [
			"afficher (\"${1:Casali le goat}\");"
		],
		"description": "Affiche un message"
	},
	"saisir": {
		"prefix": "saisir",
		"body": [
			"saisir (${1:variable});"
		],
		"description": "Lit une valeur au clavier"
	},
	"ligne_suivante": {
		"prefix": "ligne_suivante",
		"body": [
			"ligne_suivante;"
		],
		"description": "Saut de ligne"
	},
	"pour": {
		"prefix": "pour",
		"body": [
			"pour (${1:i} variant_de ${2:min} a ${3:max}) ",
			"faire",
			"\t$0",
			"ffaire"
		],
		"description": "Insertion d'un bloc de boucle \"pour\""
	},
	"tant_que": {
		"prefix": "tant_que",
		"body": [
			"tant_que (${1:condition})",
			"faire",
			"\t$0",
			"ffaire"
		],
		"description": "Insertion d'un bloc \"tant que\""
	},
	"jusqua": {
		"prefix": "jusqua",
		"body": [
			"jusqua (${1:condition})",
			"faire",
			"\t$0",
			"ffaire"
		],
		"description": "Boucle jusqua (pré-testée : tourne tant que la condition est fausse)"
	},
	"repeter": {
		"prefix": "repeter",
		"body": [
			"repeter",
			"\t$0",
			"jusqua (${1:condition})"
		],
		"description": "Boucle repeter ... jusqua (post-testée : au moins un tour)"
	},
	"boucle": {
		"prefix": "boucle",
		"body": [
			"boucle",
			"\t$0",
			"fboucle"
		],
		"description": "Boucle infinie (sortir avec sortie;)"
	},
	"vaut": {
		"prefix": "vaut",
		"body": [
			"vaut "
		],
		"description": "Comparaison : égal à (==)"
	},
	"ne_vaut_pas": {
		"prefix": "ne_vaut_pas",
		"body": [
			"ne_vaut_pas "
		],
		"description": "Comparaison : différent de (!=)"
	},
	"ET_ALORS": {
		"prefix": "ET_ALORS",
		"body": [
			"ET_ALORS "
		],
		"description": "ET logique avec court-circuit"
	},
	"OU_SINON": {
		"prefix": "OU_SINON",
		"body": [
			"OU_SINON "
		],
		"description": "OU logique avec court-circuit"
	},
	"sinon_si": {
		"prefix": "sinon_si",
		"body": [
			"sinon_si (${1:condition})"
		],
		"description": "Branche sinon_si (à insérer dans un bloc si existant)"
	},
	"redimensionner": {
		"prefix": "redimensionner",
		"body": [
			"redimensionner (${1:tableau}, ${2:taille});"
		],
		"description": "Redimensionne un tableau"
	},
	"taille": {
		"prefix": "taille",
		"body": [
			"taille (${1:tableau})"
		],
		"description": "Nombre d'éléments d'un tableau ou d'une chaine"
	},
	"modulo": {
		"prefix": "modulo",
		"body": [
			"modulo (${1:a}, ${2:b})"
		],
		"description": "Reste de la division entière"
	},
	"rand": {
		"prefix": "rand",
		"body": [
			"rand (${1:min}, ${2:max})"
		],
		"description": "Entier aléatoire entre min et max (inclus)"
	},
	"rang": {
		"prefix": "rang",
		"body": [
			"rang (${1:caractere})"
		],
		"description": "Code numérique d'un caractère"
	},
	"succ": {
		"prefix": "succ",
		"body": [
			"succ (${1:caractere})"
		],
		"description": "Caractère suivant"
	},
	"prec": {
		"prefix": "prec",
		"body": [
			"prec (${1:caractere})"
		],
		"description": "Caractère précédent"
	},
	"toupper": {
		"prefix": "toupper",
		"body": [
			"toupper (${1:caractere})"
		],
		"description": "Convertit en majuscule"
	},
	"tolower": {
		"prefix": "tolower",
		"body": [
			"tolower (${1:caractere})"
		],
		"description": "Convertit en minuscule"
	},
	"isdigit": {
		"prefix": "isdigit",
		"body": [
			"isdigit (${1:caractere})"
		],
		"description": "Vrai si le caractère est un chiffre"
	},
	"isalpha": {
		"prefix": "isalpha",
		"body": [
			"isalpha (${1:caractere})"
		],
		"description": "Vrai si le caractère est une lettre"
	},
	"isalnum": {
		"prefix": "isalnum",
		"body": [
			"isalnum (${1:caractere})"
		],
		"description": "Vrai si lettre ou chiffre"
	},
	"isspace": {
		"prefix": "isspace",
		"body": [
			"isspace (${1:caractere})"
		],
		"description": "Vrai si espace ou tabulation"
	},
	"ispunct": {
		"prefix": "ispunct",
		"body": [
			"ispunct (${1:caractere})"
		],
		"description": "Vrai si signe de ponctuation"
	},
	"isupper": {
		"prefix": "isupper",
		"body": [
			"isupper (${1:caractere})"
		],
		"description": "Vrai si majuscule"
	},
	"islower": {
		"prefix": "islower",
		"body": [
			"islower (${1:caractere})"
		],
		"description": "Vrai si minuscule"
	},
	"si": {
		"prefix": "si",
		"body": [
			"si (${1:condition})",
			"\t$0",
			"fsi"
		],
		"description": "Insertion d'un bloc \"si\""
	},
	"si_sinon": {
		"prefix": ["si_sinon", "sisinon"],
		"body": [
			"si (${1:condition})",
			"\t$0",
			"sinon",
			"\t",
			"fsi"
		],
		"description": "Insertion d'un bloc \"si-sinon\""
	},
	"declarer": {
		"prefix": "declarer",
		"body": [
			"declarer ${1:nom} : ${2|entier,entier_naturel,reel,booleen,caractere,string,tableau_de|};"
		],
		"description": "Déclaration d'une variable (menu de types)"
	},
	"declarer et affecter": {
		"prefix": "declarer_affecter",
		"body": [
			"declarer ${1:nom} : ${2|entier,entier_naturel,reel,booleen,caractere,string,tableau_de|} <- ${3:valeur};"
		],
		"description": "Déclaration avec affectation (menu de types)"
	},
	"declarer constante": {
		"prefix": "declarer_constante",
		"body": [
			"declarer K${1:nom} : ${2|entier,entier_naturel,reel,booleen,caractere,string,tableau_de|} <- ${3:valeur};"
		],
		"description": "Déclaration d'une constante (menu de types)"
	},
	"assignation": {
		"prefix": ["<-", "prend"],
		"body": [
			"<- $0"
		],
		"description": "Assignation d'une valeur à une variable"
	},
	"entier": {
		"prefix": "entier",
		"body": ["entier"],
		"description": "Type entier"
	},
	"entier_naturel": {
		"prefix": "entier_naturel",
		"body": ["entier_naturel"],
		"description": "Type entier naturel (positif)"
	},
	"reel": {
		"prefix": "reel",
		"body": ["reel"],
		"description": "Type réel"
	},
	"booleen": {
		"prefix": "booleen",
		"body": ["booleen"],
		"description": "Type booléen (vrai/faux)"
	},
	"caractere": {
		"prefix": "caractere",
		"body": ["caractere"],
		"description": "Type caractère ('a')"
	},
	"string": {
		"prefix": "string",
		"body": ["string"],
		"description": "Type chaîne de caractères"
	},
	"tableau_de": {
		"prefix": "tableau_de",
		"body": [
			"tableau_de ${1:taille} ${2|entier,entier_naturel,reel,booleen,caractere,string|}"
		],
		"description": "Type tableau (taille optionnelle, menu pour le type d'élément)"
	}
}
