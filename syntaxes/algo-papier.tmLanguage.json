{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "algo-papier",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#string"
		},
		{
			"include": "#expression"
		},
		{
			"include": "#params"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "comment.line.double-slash.algo-papier",
					"match": "//.*$"
				},
				{
					"name": "comment.block.algo-papier",
					"begin": "\\/\\*",
					"end": "\\*\\/"
				},
			{
				"name": "storage.modifier.algo-papier",
				"match": "^\\s*(debut|fin)\\b(?=\\s*(?://.*)?$)"
			},
			{
				"name": "storage.modifier.algo-papier",
				"match": "\\bfaire\\b(?=\\s*(?://.*)?$)"
			},
			{
				"name": "storage.modifier.algo-papier",
				"match": "\\bffaire\\b"
			},
			{
				"name": "keyword.control.algo-papier",
				"match": "^\\s*pour\\b"
			},
			{
				"name": "keyword.control.algo-papier",
				"match": "(?<=^\\s*pour\\b.*)\\ba\\b"
			},
			{
				"name": "keyword.control.algo-papier",
				"match": "(?<=^\\s*choix_sur\\b.*)\\bentre\\b"
			},
			{
				"name": "keyword.control.algo-papier",
				"match": "^\\s*cas\\b(?=[^:\\n]*:)"
			},
			{
				"name": "keyword.control.algo-papier",
				"match": "^\\s*autre\\b(?=\\s*:)"
			},
			{
				"name": "keyword.control.algo-papier",
				"match": "\\b(sortie|continue)\\b(?=\\s*;)"
			},
			{
				"name": "keyword.control.algo-papier",
				"match": "\\b(si|sinon_si|sinon|fsi|procedure|fonction|algorithme|tant_que|renvoie|jusqua|repeter|fchoix|choix_sur|variant_de|NON|boucle|fboucle|declarer)\\b"
			},
				{
					"name": "storage.type",
					"match": "\\b(caractere|string|tableau_de|booleen|entier|entier_naturel|reel)\\b"
				},
			{
				"name": "constant.numeric",
				"match": "\\b\\d+(\\.\\d+)?\\b"
			},
				{
					"name": "constant.language",
					"match": "\\b(vrai|faux)\\b"
				},
			{
				"name": "keyword.operator.algo-papier",
				"match": "<-|==|!=|<=|>=|<|>|=|\\+|-|\\*|/|%"
			},
			{
				"name": "keyword.control.algo-papier",
				"match": "\\b(vaut|ne_vaut_pas|OU|OU_SINON|ET|ET_ALORS)\\b"
			}
			]
		},
		"strings": {
			"name": "string.quoted.double.algo-papier",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.algo-papier",
					"match": "\\\\."
				}
			]
		},
		"string": {
			"name": "string.quoted.single.algo-papier",
			"begin": "'",
			"end": "'",
			"patterns": [
				{
					"name": "constant.character.escape.algo-papier",
					"match": "\\\\."
				}
			]
		},
		"expression": {
			"name": "support.function",
			"match": "\\b(afficher|saisir|ligne_suivante|taille|redimensionner|modulo|rand|rang|succ|prec|toupper|tolower|isdigit|isalpha|isalnum|isspace|ispunct|isupper|islower)\\b"
		},
		"params": {
			"name": "variable.parameter",
			"match": "\\b(in|in_out|out)\\b"
		}
	},
	"scopeName": "source.algo"
}