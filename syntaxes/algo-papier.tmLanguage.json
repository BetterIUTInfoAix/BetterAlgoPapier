{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "algo-papier",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#expression"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#string"
		},
		{
			"include": "#params"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "comment.line",
					"match": "//.*$"
				},
				{
					"name": "comment.block",
					"begin": "\\/\\*",
					"end": "\\*\\/"
				},
				{
					"name": "keyword.control.algo-papier",
					"match": "\\b(si|sinon_si|sinon|fsi|procedure|fonction|algorithme|tant_que|pour|renvoie|jusqua|repeter|sortie|continue|choix_sur|fchoix|cas|autre|entre|variant_de|a|NON)\\b"
				},
				{
					"name": "support.type",
					"match": "\\b(faire|ffaire|debut|fin|boucle|fboucle)\\b"
				},
				{
					"name": "variable.language",
					"match": "\\b(declarer)\\b"
				},
				{
					"name": "storage.type",
					"match": "\\b(caractere|string|tableau_de|booleen|entier|entier_naturel|reel)\\b"
				},
			{
				"name": "constant.numeric",
				"match": "\\b\\d+(\\.\\d+)?\\b"
			},
				{
					"name": "constant.language",
					"match": "\\b(vrai|faux)\\b"
				},
			{
				"name": "keyword.operator.algo-papier",
				"match": "<-|==|!=|<=|>=|<|>|=|\\+|-|\\*|/|%"
			},
			{
				"name": "keyword.control.algo-papier",
				"match": "\\b(vaut|ne_vaut_pas|OU|OU_SINON|ET|ET_ALORS)\\b"
			}
			]
		},
		"strings": {
			"name": "string.quoted.double.algo-papier",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.algo-papier",
					"match": "\\\\."
				}
			]
		},
		"string": {
			"name": "constant.character",
			"begin": "'",
			"end": "'",
			"patterns": [
				{
					"name": "constant.character.escape.algo-papier",
					"match": "\\\\."
				}
			]
		},
		"expression": {
			"name": "support.function",
			"match": "\\b(afficher|saisir|ligne_suivante|taille|redimensionner|modulo|rand|rang|succ|prec|toupper|tolower|isdigit|isalpha|isalnum|isspace|ispunct|isupper|islower)\\b"
		},
		"params": {
			"name": "variable.parameter",
			"match": "\\b(in|in_out|out)\\b"
		}
	},
	"scopeName": "source.algo"
}