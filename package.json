{
    "name": "better-algo-papier",
    "displayName": "Better Algo Papier",
    "publisher": "betteriutinfoaix",
    "author": { "name": "BetterIUTInfoAix" },
    "repository": {
        "type": "git",
        "url": "https://github.com/BetterIUTInfoAix/BetterAlgoPapier"
    },
    "description": "Coloration syntaxique, snippets et complétion pour l'algorithmique sur papier de l'IUT d'Aix",
    "icon": "extension.png",
    "version": "1.0.4",

    "engines": {
        "vscode": "^1.138.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "algo",
        "papier",
        "algorithmique",
        "pseudocode",
        "Algo Papier",
        "Casali"
    ],
    "contributes": {
        "configurationDefaults": {
            "[algo-papier]": {
                "editor.quickSuggestions": {
                    "other": true,
                    "comments": "off",
                    "strings": "off"
                },
                "editor.suggest.snippetsPreventQuickSuggestions": false
            }
        },
        "languages": [
            {
                "id": "algo-papier",
                "aliases": [
                    "better-algo-papier",
                    "algo-papier"
                ],
                "extensions": [
                    ".algo"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "algo-papier",
                "scopeName": "source.algo",
                "path": "./syntaxes/algo-papier.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "algo-papier",
                "path": "./snippets/snippets.json"
            }
        ]
    }
}
