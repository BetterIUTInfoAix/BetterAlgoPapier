{
    "comments": {
        "lineComment": "//",
        "blockComment": [
            "/*",
            "*/"
        ]
    },
    "brackets": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ]
    ],
    "colorizedBracketPairs": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"]
    ],
    "autoClosingPairs": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ],
        [
            "\"",
            "\""
        ],
        [
            "'",
            "'"
        ]
    ],
    "surroundingPairs": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ],
        [
            "\"",
            "\""
        ],
        [
            "'",
            "'"
        ]
    ],
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(algorithme\\b.*|procedure\\b.*|fonction\\b.*|debut|si\\s*\\(.*\\)|sinon|sinon_si\\s*\\(.*\\)|faire|boucle|repeter|choix_sur\\b.*entre|cas\\b.*:|autre\\s*:)\\s*$",
        "decreaseIndentPattern": "^\\s*(fin|fsi|sinon|sinon_si\\s*\\(.*\\)|ffaire|fboucle|fchoix|cas\\b.*:|autre\\s*:)\\s*$"
    },
    "folding": {
        "markers": {
            "start": "^\\s*(algorithme\\b|procedure\\b|fonction\\b|debut\\b|si\\s*\\(|boucle\\b|repeter\\b|choix_sur\\b|faire\\b)",
            "end": "^\\s*(fin\\b|fsi\\b|fboucle\\b|ffaire\\b|fchoix\\b)"
        }
    }
}